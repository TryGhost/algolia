{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "release": {
    "projects": [
      "packages/*"
    ],
    "projectsRelationship": "independent",
    "version": {
      "preserveMatchingDependencyRanges": false
    },
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": {
        "createRelease": false,
        "renderOptions": {
          "authors": false,
          "commitReferences": false
        }
      }
    },
    "git": {
      "commit": true,
      "tag": true,
      "commitMessage": "Published new versions"
    },
    "versionPlans": {
      "ignorePatternsForPlanCheck": [
        "**/test/**",
        "**/*.md"
      ]
    }
  },
  "targetDefaults": {
    "build": {
      "dependsOn": [
        "^build"
      ]
    }
  },
  "analytics": false
}
