{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "release": {
    "projects": ["packages/*"],
    "projectsRelationship": "independent",
    "version": {
      "preserveMatchingDependencyRanges": false,
      "git": {
        "commit": true,
        "tag": true,
        "commitMessage": "Published new versions"
      }
    },
    "changelog": {
      "workspaceChangelog": false
    }
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"]
    }
  },
  "analytics": false
}
