{
  "private": true,
  "repository": "https://github.com/TryGhost/algolia",
  "author": "Ghost Foundation",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "echo \"Implement me!\"",
    "build": "pnpm --filter @tryghost/algolia-html-extractor build && pnpm --filter @tryghost/algolia-fragmenter build",
    "pretest": "pnpm build",
    "test": "NODE_ENV=testing vitest run",
    "pretest:coverage": "pnpm build",
    "test:coverage": "NODE_ENV=testing vitest run --coverage",
    "posttest:coverage": "node ./test/verify-coverage.mjs",
    "posttest": "pnpm typecheck && pnpm lint",
    "typecheck": "pnpm --filter @tryghost/algolia-fragmenter typecheck && pnpm --filter @tryghost/algolia-netlify typecheck && pnpm --filter @tryghost/algolia-html-extractor typecheck && pnpm --filter @tryghost/algolia typecheck && pnpm --filter @tryghost/algolia-netlify exec tsc --project ../../deployment/tsconfig.json",
    "lint": "oxlint --quiet && oxfmt --check .",
    "lint:fix": "oxlint --fix && oxfmt .",
    "format": "oxfmt .",
    "preship": "git diff --quiet && git diff --cached --quiet || (echo 'Error: working tree must be clean before shipping' && exit 1) && pnpm test",
    "ship": "node scripts/ship.mts",
    "ship:patch": "pnpm ship patch",
    "ship:minor": "pnpm ship minor",
    "ship:major": "pnpm ship major"
  },
  "devDependencies": {
    "@nx/js": "23.3.0",
    "@types/semver": "7.8.0",
    "@vitest/coverage-v8": "5.0.5",
    "nx": "23.3.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.89.0",
    "semver": "7.8.5",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
