{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "inlineSources": true,
    "noEmit": false,
    "outDir": "lib",
    "paths": {},
    "rootDir": "src",
    "sourceMap": true,
    "tsBuildInfoFile": "lib/.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.mts"]
}
