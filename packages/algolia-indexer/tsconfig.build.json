{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "declaration": true,
        "declarationMap": true,
        "incremental": true,
        "inlineSources": true,
        "noEmit": false,
        "outDir": "dist",
        "rootDir": "src",
        "sourceMap": true,
        "tsBuildInfoFile": "dist/.tsbuildinfo"
    },
    "include": ["src/**/*.cts"]
}
